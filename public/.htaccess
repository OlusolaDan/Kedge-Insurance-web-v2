Options -Indexes
DirectoryIndex index.html

<IfModule mod_env.c>
  SetEnv KEDGE_ENQUIRY_EMAIL "info@kedgeinsure.com.ng"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Vite asset filenames contain content hashes. They can be cached for a year
  # because a changed file receives a new URL on the next build. HTML remains
  # short-lived below so route and asset manifests can update promptly.
  <FilesMatch "\.(?:css|js|mjs|json|map|jpg|jpeg|png|gif|svg|webp|avif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:index|404)\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>
